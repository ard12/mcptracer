{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ard12/mcptracer/schemas/diff-report.v3.schema.json",
  "title": "MCPTracer diff --json / assert --golden --json output (v3)",
  "description": "Output of `mcptracer diff <a> <b> --json` and `mcptracer assert <session> --golden <golden> --json` -- both emit the same mcptracer_model::diff::DiffReport. v3 adds two changes relative to v2: a required `schema_version` integer field naming the major version of this schema the document conforms to (so a CI job pinned to a schema can detect the shape it received instead of guessing from content), and `exchangeStatus` now serializes in snake_case (`\"ok\"`, `\"tool_error\"`, ...) instead of the PascalCase Rust variant names v1/v2 leaked (`\"Ok\"`, `\"ToolError\"`, ...), matching the snake_case convention every other enum in these schemas already uses. Bump the filename version and add a new schema on any breaking change; do not edit this file in place once published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "changed",
    "added",
    "removed",
    "tools_added",
    "tools_removed",
    "security",
    "error_rate_from",
    "error_rate_to"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "changed": {
      "type": "array",
      "items": { "$ref": "#/$defs/alignedExchangeDiff" }
    },
    "added": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alignment keys present only in the second (later) session."
    },
    "removed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alignment keys present only in the first (earlier) session."
    },
    "tools_added": { "type": "array", "items": { "type": "string" } },
    "tools_removed": { "type": "array", "items": { "type": "string" } },
    "security": {
      "type": "array",
      "items": { "$ref": "#/$defs/securityFinding" }
    },
    "error_rate_from": { "type": "number" },
    "error_rate_to": { "type": "number" },
    "point_of_divergence": {
      "$ref": "#/$defs/pointOfDivergence"
    }
  },
  "$defs": {
    "pointOfDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "key", "kind", "detail"],
      "properties": {
        "step_index": { "type": "integer" },
        "key": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "method_mismatch",
            "status_mismatch",
            "error_code_mismatch",
            "request_mismatch",
            "response_mismatch",
            "missing_exchange",
            "extra_exchange"
          ]
        },
        "detail": { "type": "string" }
      }
    },
    "exchangeStatus": {
      "type": "string",
      "enum": ["ok", "error", "tool_error", "subscribed", "unanswered", "orphan_response"]
    },
    "alignedExchangeDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "deltas"],
      "properties": {
        "key": {
          "type": "string",
          "description": "method[ tool]#ordinal, e.g. 'tools/call echo#0'."
        },
        "deltas": {
          "type": "array",
          "items": { "$ref": "#/$defs/exchangeDelta" }
        }
      }
    },
    "exchangeDelta": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "status_changed" },
            "from": { "$ref": "#/$defs/exchangeStatus" },
            "to": { "$ref": "#/$defs/exchangeStatus" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "error_code_changed" },
            "from": { "type": ["integer", "null"] },
            "to": { "type": ["integer", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pointer_diffs"],
          "properties": {
            "kind": { "const": "request_changed" },
            "pointer_diffs": {
              "type": "array",
              "items": { "$ref": "#/$defs/pointerDiff" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pointer_diffs"],
          "properties": {
            "kind": { "const": "response_changed" },
            "pointer_diffs": {
              "type": "array",
              "items": { "$ref": "#/$defs/pointerDiff" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from_ns", "to_ns", "pct"],
          "properties": {
            "kind": { "const": "latency_changed" },
            "from_ns": { "type": "integer" },
            "to_ns": { "type": "integer" },
            "pct": { "type": "number" }
          }
        }
      ]
    },
    "pointerDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "from", "to"],
      "properties": {
        "pointer": {
          "type": "string",
          "description": "JSON pointer relative to the compared subtree (params, result, or error)."
        },
        "from": {
          "description": "Value in the first session; JSON null means absent."
        },
        "to": {
          "description": "Value in the second session; JSON null means absent."
        }
      }
    },
    "securityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tool", "detail"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tool_added",
            "tool_removed",
            "tool_title_changed",
            "tool_description_changed",
            "tool_schema_changed",
            "tool_output_schema_changed",
            "tool_annotations_changed"
          ]
        },
        "tool": { "type": "string" },
        "detail": { "type": "string" }
      }
    }
  }
}
