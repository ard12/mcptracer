{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ard12/mcptracer/schemas/bench-report.v1.schema.json",
  "title": "MCPTracer bench --json output (v1)",
  "description": "Output of `mcptracer bench <session-id> --json -- <server-command>`. Bump the filename version and add a new schema on any breaking change; do not edit this file in place once published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iterations",
    "concurrency",
    "total_requests",
    "total_errors",
    "unanswered",
    "throughput_sessions_per_sec",
    "throughput_requests_per_sec",
    "duration_ms",
    "latency_p50_ms",
    "latency_p90_ms",
    "latency_p95_ms",
    "latency_p99_ms",
    "latency_max_ms"
  ],
  "properties": {
    "iterations": { "type": "integer", "minimum": 0 },
    "concurrency": { "type": "integer", "minimum": 0 },
    "total_requests": { "type": "integer", "minimum": 0 },
    "total_errors": { "type": "integer", "minimum": 0 },
    "unanswered": { "type": "integer", "minimum": 0 },
    "throughput_sessions_per_sec": { "type": "number" },
    "throughput_requests_per_sec": { "type": "number" },
    "duration_ms": { "type": "number" },
    "latency_p50_ms": { "type": ["number", "null"] },
    "latency_p90_ms": { "type": ["number", "null"] },
    "latency_p95_ms": { "type": ["number", "null"] },
    "latency_p99_ms": { "type": ["number", "null"] },
    "latency_max_ms": {
      "type": ["number", "null"],
      "description": "null in every one of these latency fields only when total_requests is 0 (no request ever received a response to time)."
    }
  }
}
